# Database
DATABASE_URL="postgres://user:password@host:5432/dbname"

# JWT Secret (gere uma chave secreta forte)
JWT_SECRET="sua-chave-secreta-aqui-gere-uma-forte"

# Next Auth
NEXTAUTH_SECRET="sua-nextauth-secret-aqui"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (para upload de arquivos)
BLOB_READ_WRITE_TOKEN="vercel_blob_token_aqui"

# E-mail SMTP (para notificações e sistema de visitas)
EMAIL_HOST="smtp.exemplo.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER="usuario@exemplo.com"
EMAIL_PASSWORD="senha-do-email"
EMAIL_FROM="noreply@cense.pr.gov.br"

# Monitoramento / Sentry
SENTRY_DSN="https://xxxxxxxx.ingest.sentry.io/project"
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx.ingest.sentry.io/project"
SENTRY_ENVIRONMENT="development"
SENTRY_ALERT_EMAIL="censeinteligencia@gmail.com"
