generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Operador {
  id                              String                     @id @default(uuid())
  nomeCompleto                    String                     @map("nome_completo")
  email                           String                     @unique
  senhaHash                       String                     @map("senha_hash")
  funcaoRole                      String                     @map("funcao_role")
  status                          String                     @default("ATIVO")
  criadoEm                        DateTime                   @default(now()) @map("criado_em")
  atualizadoEm                    DateTime                   @updatedAt @map("atualizado_em")
  decisoesOperacionais            DecisaoOperacional[]
  gruposEspeciais                 GrupoEspecial[]
  historicoMovimentacao           HistoricoMovimentacao[]
  justificativasAlgemaAprovador   JustificativaAlgema[]      @relation("JustificativaAlgemaAprovador")
  justificativasAlgemaResponsavel JustificativaAlgema[]      @relation("JustificativaAlgemaResponsavel")
  logAuditoria                    LogAuditoria[]
  atosInfracionaisCriados         AtoInfracionalCatalogo[]   @relation("AtoInfracionalCatalogoCriador")
  declaracoesFaccaoCriadas        AdolescenteFaccaoHistorico[] @relation("OperadorCriadorFaccaoHistorico")
  papeis                          OperadorPapel[]
  solicitacoesTransf              SolicitacaoTransferencia[]
  consultasBnmp                   Visitante[]               @relation("VisitanteBnmpOperador")

  @@map("operadores")
}

model Permissao {
  id           String           @id @default(uuid())
  codigo       String           @unique
  descricao    String
  criadoEm     DateTime         @default(now()) @map("criado_em")
  atualizadoEm DateTime         @default(now()) @updatedAt @map("atualizado_em")
  papeis       PapelPermissao[]

  @@map("permissoes")
}

model Papel {
  id           String           @id @default(uuid())
  nome         String           @unique
  descricao    String?
  criadoEm     DateTime         @default(now()) @map("criado_em")
  atualizadoEm DateTime         @default(now()) @updatedAt @map("atualizado_em")
  operadores   OperadorPapel[]
  permissoes   PapelPermissao[]

  @@map("papeis")
}

model PapelPermissao {
  id          String    @id @default(uuid())
  papelId     String    @map("papel_id")
  permissaoId String    @map("permissao_id")
  papel       Papel     @relation(fields: [papelId], references: [id])
  permissao   Permissao @relation(fields: [permissaoId], references: [id])

  @@unique([papelId, permissaoId])
  @@map("papeis_permissoes")
}

model OperadorPapel {
  id         String   @id @default(uuid())
  operadorId String   @map("operador_id")
  papelId    String   @map("papel_id")
  operador   Operador @relation(fields: [operadorId], references: [id])
  papel      Papel    @relation(fields: [papelId], references: [id])

  @@unique([operadorId, papelId])
  @@map("operadores_papeis")
}

model TecnicoReferencia {
  id                     String        @id @default(uuid())
  nome                   String
  atividade              String?
  email                  String        @unique
  telefone               String?
  criadoEm               DateTime      @default(now()) @map("criado_em")
  atualizadoEm           DateTime      @updatedAt @map("atualizado_em")
  adolescentesReferencia AdolescenteTecnicoReferencia[]

  @@map("agentes_profissionais")
}

model Casa {
  id                           String                  @id @default(uuid())
  nome                         String
  numero                       Int                     @unique
  isolada                      Boolean                 @default(false)
  observacoes                  String?
  destinacaoOperacional        String                  @default("DEFINITIVA") @map("destinacao_operacional") @db.VarChar(32)
  faseExclusivaId              String?                 @map("fase_exclusiva_id")
  prazoMaximoDias              Int?                    @map("prazo_maximo_dias")
  riscoMaximoPermitido         Int?                    @map("risco_maximo_permitido")
  alojamentos                  Alojamento[]
  faseExclusiva                FaseInternacao?         @relation("CasaFaseExclusiva", fields: [faseExclusivaId], references: [id])
  grupos                       Grupo[]
  gruposEspeciaisCasa          GrupoEspecialCasa[]
  historicoDestinoMovimentacao HistoricoMovimentacao[] @relation("HistoricoDestinoCasa")
  historicoOrigemMovimentacao  HistoricoMovimentacao[] @relation("HistoricoOrigemCasa")

  @@map("casas")
}

model Alojamento {
  id                            String                  @id @default(uuid())
  casaId                        String                  @map("casa_id")
  numeroAlojamento              String                  @map("numero_alojamento")
  ala                           String?
  statusManutencao              String                  @default("LIVRE") @map("status_manutencao")
  alojamentoFrontalId           String?                 @map("alojamento_frontal_id")
  zonaRiscoId                   String?                 @map("zona_risco_id")
  localizacaoPreferencial       Boolean                 @default(false) @map("localizacao_preferencial")
  interdicaoJustificativa       String?                 @map("interdicao_justificativa")
  interdicaoDocumentoTipo       String?                 @map("interdicao_documento_tipo") @db.VarChar(64)
  interdicaoDocumentoReferencia String?                 @map("interdicao_documento_referencia")
  adolescentes                  Adolescente[]
  alojamentoFrontal             Alojamento?             @relation("AlojamentoFrontal", fields: [alojamentoFrontalId], references: [id])
  alojamentoOpo                 Alojamento[]            @relation("AlojamentoFrontal")
  casa                          Casa                    @relation(fields: [casaId], references: [id])
  zonaRisco                     ZonaRisco?              @relation(fields: [zonaRiscoId], references: [id])
  historicoDestinoMovimentacao  HistoricoMovimentacao[] @relation("HistoricoDestinoAlojamento")
  historicoOrigemMovimentacao   HistoricoMovimentacao[] @relation("HistoricoOrigemAlojamento")
  zonasRiscoAloj                ZonaRiscoAlojamento[]

  @@unique([casaId, numeroAlojamento])
  @@map("alojamentos")
}

model ZonaRisco {
  id              String                @id @default(uuid())
  nomeZona        String                @map("nome_zona") @unique
  descricao       String?
  alojamentos     Alojamento[]
  alojamentosLink ZonaRiscoAlojamento[]
  zonasVinculoA   ZonaRiscoVinculo[]    @relation("ZonaA")
  zonasVinculoB   ZonaRiscoVinculo[]    @relation("ZonaB")

  @@map("zonas_risco")
}

model ZonaRiscoAlojamento {
  id           String     @id @default(uuid())
  zonaId       String     @map("zona_id")
  alojamentoId String     @map("alojamento_id")
  alojamento   Alojamento @relation(fields: [alojamentoId], references: [id])
  zona         ZonaRisco  @relation(fields: [zonaId], references: [id])

  @@map("zonas_risco_alojamentos")
}

model ZonaRiscoVinculo {
  id      String    @id @default(uuid())
  zonaAId String    @map("zona_a_id")
  zonaBId String    @map("zona_b_id")
  zonaA   ZonaRisco @relation("ZonaA", fields: [zonaAId], references: [id])
  zonaB   ZonaRisco @relation("ZonaB", fields: [zonaBId], references: [id])

  @@map("zonas_risco_vinculos")
}

model Faccao {
  id               String           @id @default(uuid())
  nomeFaccao       String           @unique @map("nome_faccao")
  descricao        String?
  adolescentes     Adolescente[]
  declaracoes      AdolescenteFaccaoHistorico[] @relation("DeclaracaoFaccao")
  conflitosFaccaoA FaccaoConflito[] @relation("FaccaoA")
  conflitosFaccaoB FaccaoConflito[] @relation("FaccaoB")
  tatuagensAssociadas TatuagemCatalogoFaccao[]

  @@map("faccoes")
}

model Cidade {
  id           String   @id @default(uuid())
  nome         String
  estado       String   @db.VarChar(2)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  bairros      Bairro[]

  @@unique([nome, estado])
  @@map("cidades")
}

model FaccaoConflito {
  id              String   @id @default(uuid())
  faccaoAId       String   @map("faccao_a_id")
  faccaoBId       String   @map("faccao_b_id")
  status          String   @default("ATIVO")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")
  fonteInformacao String?  @map("fonte_informacao")
  faccaoA         Faccao   @relation("FaccaoA", fields: [faccaoAId], references: [id])
  faccaoB         Faccao   @relation("FaccaoB", fields: [faccaoBId], references: [id])

  @@map("faccoes_conflitos")
}

model Bairro {
  id                String           @id @default(uuid())
  nomeBairro        String           @map("nome_bairro")
  cidadeId          String           @map("cidade_id")
  cidade            String
  cidadeCatalogo    Cidade           @relation(fields: [cidadeId], references: [id])
  adolescentes      Adolescente[]
  bairrosConflitosA BairroConflito[] @relation("BairroA")
  bairrosConflitosB BairroConflito[] @relation("BairroB")

  @@index([cidadeId])
  @@unique([nomeBairro, cidadeId])
  @@map("bairros")
}

model AtoInfracionalCatalogo {
  id            String      @id @default(uuid())
  nome          String
  gravidade     String?
  violenciaOuGraveAmeaca Boolean @default(false) @map("violencia_ou_grave_ameaca")
  ativo         Boolean     @default(true)
  criadoEm      DateTime    @default(now()) @map("criado_em")
  criadoPorId   String?     @map("criado_por_id")
  criadoPor     Operador?   @relation("AtoInfracionalCatalogoCriador", fields: [criadoPorId], references: [id])
  historicos    AdolescenteHistoricoInfracional[]
  casoTipificacoes AdolescenteCasoInfracionalTipificacao[]

  @@map("atos_infracionais_catalogo")
  @@index([ativo])
  @@unique([nome], map: "atos_infracionais_catalogo_nome_key")
}

model BairroConflito {
  id              String  @id @default(uuid())
  bairroAId       String  @map("bairro_a_id")
  barroBId        String  @map("bairro_b_id")
  status          String  @default("ATIVO")
  fonteInformacao String? @map("fonte_informacao")
  bairroA         Bairro  @relation("BairroA", fields: [bairroAId], references: [id])
  bairroB         Bairro  @relation("BairroB", fields: [barroBId], references: [id])

  @@map("bairros_conflitos")
}

model TatuagemCatalogo {
  id                    String                @id @default(uuid())
  nomeSimbolo           String                @unique @map("nome_simbolo")
  significadoAssociado  String?               @map("significado_associado")
  nivelRisco            String?               @map("nivel_risco")
  adolescentesTatuagens AdolescenteTatuagem[]
  faccoesAssociadas     TatuagemCatalogoFaccao[]

  @@map("tatuagens_catalogo")
}

model TatuagemCatalogoFaccao {
  id                 String           @id @default(uuid())
  tatuagemCatalogoId String           @map("tatuagem_catalogo_id")
  faccaoId           String           @map("faccao_id")
  tatuagemCatalogo   TatuagemCatalogo @relation(fields: [tatuagemCatalogoId], references: [id], onDelete: Cascade)
  faccao             Faccao           @relation(fields: [faccaoId], references: [id], onDelete: Cascade)

  @@unique([tatuagemCatalogoId, faccaoId])
  @@map("tatuagens_catalogo_faccoes")
}

model FaseInternacao {
  id            String        @id @default(uuid())
  nomeFase      String        @unique @map("nome_fase")
  descricaoFase String?       @map("descricao_fase")
  ordem         Int?
  ativa         Boolean       @default(true)
  permiteCasa08 Boolean       @default(false) @map("permite_casa_08")
  adolescentes  Adolescente[]
  casasExclusivas Casa[]      @relation("CasaFaseExclusiva")

  @@map("fases_internacao")
}

model Adolescente {
  id                         String                            @id @default(uuid())
  nomeCompleto               String                            @map("nome_completo")
  nomeSocial                 String?                           @map("nome_social")
  fotoUrl                    String?                           @map("foto_url")
  numeroSms                  String?                           @map("numero_sms")
  dataNascimento             DateTime?                         @map("data_nascimento") @db.Date
  dataEntrada                DateTime?                         @map("data_entrada")
  statusUnidade              String                            @default("ATIVO") @map("status_unidade")
  faccaoGrupoId              String?                           @map("faccao_grupo_id")
  bairroOrigemId             String?                           @map("bairro_origem_id")
  riscoFuga                  String?                           @map("risco_fuga")
  alertaRiscoSuicidio        Boolean                           @default(false) @map("alerta_risco_suicidio")
  alertaPerfilMapeado        Boolean                           @default(false) @map("alerta_perfil_mapeado")
  alertaSaudeConfidencial    Boolean                           @default(false) @map("alerta_saude_confidencial")
  alertaSaudeDetalhes        String?                           @map("alerta_saude_detalhes")
  alojamentoAtualId          String?                           @map("alojamento_atual_id")
  faseInternacaoAtualId      String?                           @map("fase_internacao_atual_id")
  criadoEm                   DateTime                          @default(now()) @map("criado_em")
  atualizadoEm               DateTime                          @updatedAt @map("atualizado_em")
  atoInfracionalGravidade    Boolean                           @default(false) @map("ato_infracional_gravidade")
  atoInfracionalGravidadeObs String?                           @map("ato_infracional_gravidade_obs")
  dataDesinternacao          DateTime?                         @map("data_desinternacao")
  numeroInterno              Int?                              @map("numero_interno")
  vulgo                      String?                           @map("vulgo")
  faccaoFuncao               String?                           @map("faccao_funcao")
  faccaoInformacaoOrigem     String?                           @map("faccao_informacao_origem")
  faccaoInformacaoDetalhe    String?                           @map("faccao_informacao_detalhe")
  faccaoVinculoAtualId       String?                           @unique @db.Uuid @map("faccao_vinculo_atual_id")
  tecnicosReferencia         AdolescenteTecnicoReferencia[]
  alojamentoAtual            Alojamento?                       @relation(fields: [alojamentoAtualId], references: [id])
  bairroOrigem               Bairro?                           @relation(fields: [bairroOrigemId], references: [id])
  faccao                     Faccao?                           @relation(fields: [faccaoGrupoId], references: [id])
  faccaoVinculoAtual         AdolescenteFaccaoHistorico?       @relation("FaccaoVinculoAtual", fields: [faccaoVinculoAtualId], references: [id])
  faseInternacaoAtual        FaseInternacao?                   @relation(fields: [faseInternacaoAtualId], references: [id])
  historicoInfracional       AdolescenteHistoricoInfracional[]
  tatuagens                  AdolescenteTatuagem[]
  visitantesLink             AdolescenteVisitanteLink[]
  alertasAtivos              AlertaAtivo[]
  comunicadosInternos        ComunicadoInternoAdolescente[]
  conflitosA                 Conflito[]                        @relation("AdolescenteA")
  conflitosB                 Conflito[]                        @relation("AdolescenteB")
  decisoesOperacionais       DecisaoOperacional[]
  eventosParticipantes       EventoEspecialParticipante[]
  gruposEspeciais            GrupoEspecialMembro[]
  gruposMembros              GrupoMembro[]
  historicoMovimentacao      HistoricoMovimentacao[]
  historicoTransferencias    HistoricoTransferencia[]
  justificativasAlgema       JustificativaAlgema[]
  solicitacoesTransf         SolicitacaoTransferencia[]
  faccaoHistorico            AdolescenteFaccaoHistorico[]      @relation("AdolescenteFaccaoHistorico")
  faccaoInformacoesPrestadas AdolescenteFaccaoHistorico[]      @relation("FaccaoInformante")
  visitasRegistro            VisitaRegistro[]
  atoInfracionalVinculos     AtoInfracionalVinculoAdolescente[]
  casosInfracionais          AdolescenteCasoInfracional[]

  @@map("adolescentes")
}

model AdolescenteCasoInfracional {
  id                 String                         @id @default(uuid())
  adolescenteId      String                         @map("adolescente_id")
  status             String                         @default("ATUAL")
  numeroProcesso     String?                        @map("numero_processo")
  anoFato            Int?                           @map("ano_fato")
  comarca            String?
  narrativa          String?
  criadoEm           DateTime                       @default(now()) @map("criado_em")
  atualizadoEm       DateTime                       @updatedAt @map("atualizado_em")
  adolescente        Adolescente                    @relation(fields: [adolescenteId], references: [id], onDelete: Cascade)
  tipificacoes       AdolescenteCasoInfracionalTipificacao[]

  @@index([adolescenteId, status])
  @@map("adolescentes_casos_infracionais")
}

model AdolescenteCasoInfracionalTipificacao {
  id                      String                          @id @default(uuid())
  casoId                  String                          @map("caso_id")
  ordem                   Int                             @default(1)
  atoInfracionalCatalogoId String?                       @map("ato_infracional_catalogo_id")
  descricaoManual         String?                         @map("descricao_manual")
  principal               Boolean                         @default(false)
  qualificadora           String?
  majorante               String?
  observacoes             String?
  criadoEm                DateTime                        @default(now()) @map("criado_em")
  atualizadoEm            DateTime                        @updatedAt @map("atualizado_em")
  caso                    AdolescenteCasoInfracional      @relation(fields: [casoId], references: [id], onDelete: Cascade)
  atoInfracionalCatalogo  AtoInfracionalCatalogo?         @relation(fields: [atoInfracionalCatalogoId], references: [id])

  @@index([casoId, ordem])
  @@map("adolescentes_casos_infracionais_tipificacoes")
}

model AdolescenteFaccaoHistorico {
  id                String     @id @default(uuid()) @db.Uuid
  adolescenteId     String     @map("adolescente_id")
  faccaoId          String?    @map("faccao_id")
  faccao            Faccao?    @relation("DeclaracaoFaccao", fields: [faccaoId], references: [id])
  funcao            String?    @map("funcao")
  origemInformacao  String     @map("origem_informacao") // CONFESSADA, OBSERVACAO, INTELIGENCIA, TERCEIROS, NAO_INFORMADO
  nivelConfianca    String?    @map("nivel_confianca")   // BAIXO, MEDIO, ALTO, NAO_AVALIADO
  statusRegistro    String     @default("ATIVA") @map("status_registro") // ATIVA, CONTESTADA, REVOGADA
  observacao        String?    @map("observacao")
  fonte             String?    @map("fonte")
  informanteAdolescenteId String?    @db.Text @map("informante_adolescente_id")
  informanteAdolescente   Adolescente? @relation("FaccaoInformante", fields: [informanteAdolescenteId], references: [id])
  criadoEm          DateTime   @default(now()) @map("criado_em")
  criadoPorId       String?    @map("criado_por_id")
  criadoPor         Operador?  @relation("OperadorCriadorFaccaoHistorico", fields: [criadoPorId], references: [id])
  adolescente       Adolescente @relation("AdolescenteFaccaoHistorico", fields: [adolescenteId], references: [id])
  vinculoAtualDe    Adolescente? @relation("FaccaoVinculoAtual")

  @@map("adolescentes_faccao_historico")
  @@index([adolescenteId, statusRegistro])
}


model AdolescenteTecnicoReferencia {
  id                   String              @id @default(uuid()) @db.Uuid
  adolescenteId        String              @map("adolescente_id")
  tecnicoReferenciaId  String              @map("tecnico_referencia_id")
  criadoEm             DateTime            @default(now()) @map("criado_em")
  adolescente          Adolescente         @relation(fields: [adolescenteId], references: [id], onDelete: Cascade)
  tecnicoReferencia    TecnicoReferencia   @relation(fields: [tecnicoReferenciaId], references: [id], onDelete: Cascade)

  @@unique([adolescenteId, tecnicoReferenciaId])
  @@map("adolescentes_tecnicos_referencia")
}

model AdolescenteTatuagem {
  id                 String           @id @default(uuid())
  adolescenteId      String           @map("adolescente_id")
  tatuagemCatalogoId String           @map("tatuagem_catalogo_id")
  localCorpo         String?          @map("local_corpo")
  fotoUrl            String?          @map("foto_url")
  observacoes        String?
  significadoPessoal String?          @map("significado_pessoal")
  adolescente        Adolescente      @relation(fields: [adolescenteId], references: [id])
  tatuagemCatalogo   TatuagemCatalogo @relation(fields: [tatuagemCatalogoId], references: [id])

  @@map("adolescentes_tatuagens")
}

model AdolescenteHistoricoInfracional {
  id                         String      @id @default(uuid())
  adolescenteId              String      @map("adolescente_id")
  atoInfracionalDescricao    String      @map("ato_infracional_descricao")
  atoInfracionalCatalogoId   String?     @map("ato_infracional_catalogo_id")
  unidadeInternacao          String?     @map("unidade_internacao")
  ano                        Int?
  observacoes                String?
  atoInfracionalAno          Int?        @map("ato_infracional_ano")
  atoInfracionalProcesso     String?     @map("ato_infracional_processo")
  atoInfracionalGravidade    Boolean     @default(false) @map("ato_infracional_gravidade")
  atoInfracionalGravidadeObs String?     @map("ato_infracional_gravidade_obs")
  adolescente                Adolescente @relation(fields: [adolescenteId], references: [id])
  atoInfracionalCatalogo     AtoInfracionalCatalogo? @relation(fields: [atoInfracionalCatalogoId], references: [id])

  @@map("adolescentes_historico_infracional")
}

model AtoInfracionalVinculo {
  id          String                           @id @default(uuid())
  descricao   String
  criadoEm    DateTime                         @default(now()) @map("criado_em")
  atualizadoEm DateTime                        @updatedAt @map("atualizado_em")
  adolescentes AtoInfracionalVinculoAdolescente[]

  @@map("atos_infracionais_vinculos")
}

model AtoInfracionalVinculoAdolescente {
  id            String               @id @default(uuid())
  vinculoId     String               @map("vinculo_id")
  adolescenteId String               @map("adolescente_id")
  criadoEm      DateTime             @default(now()) @map("criado_em")
  vinculo       AtoInfracionalVinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  adolescente   Adolescente          @relation(fields: [adolescenteId], references: [id], onDelete: Cascade)

  @@unique([vinculoId, adolescenteId])
  @@index([adolescenteId])
  @@map("atos_infracionais_vinculos_adolescentes")
}

model Grupo {
  id                   String                @id @default(uuid())
  nomeGrupo            String                @map("nome_grupo")
  casaId               String                @map("casa_id")
  ordemAla             String?               @map("ordem_ala")
  status               String                @default("ATIVO")
  criadoEm             DateTime              @default(now()) @map("criado_em")
  decisoesOperacionais DecisaoOperacional[]
  eventosGrupos        EventoEspecialGrupo[]
  casa                 Casa                  @relation(fields: [casaId], references: [id])
  membros              GrupoMembro[]

  @@map("grupos")
}

model GrupoEspecial {
  id         String                @id @default(uuid()) @db.Uuid
  nome       String
  tipo       String                @default("ESPECIAL")
  descricao  String?
  operadorId String                @map("operador_id")
  criadoEm   DateTime              @default(now()) @map("criado_em")
  ativo      Boolean               @default(true)
  operador   Operador              @relation(fields: [operadorId], references: [id], onUpdate: NoAction)
  casas      GrupoEspecialCasa[]
  membros    GrupoEspecialMembro[]

  @@map("grupos_especiais")
}

model GrupoEspecialCasa {
  id       String        @id @default(uuid()) @db.Uuid
  grupoId  String        @map("grupo_id") @db.Uuid
  casaId   String        @map("casa_id")
  criadoEm DateTime      @default(now()) @map("criado_em")
  casa     Casa          @relation(fields: [casaId], references: [id], onUpdate: NoAction)
  grupo    GrupoEspecial @relation(fields: [grupoId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([grupoId, casaId])
